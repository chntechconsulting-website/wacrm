# WaCRM Environment Configuration Template
PROJECT_NAME="WaCRM"
API_V1_STR="/api"
SECRET_KEY="replace-with-a-secure-random-secret-key-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES="10080"

# MySQL Database
DATABASE_URL="mysql+pymysql://root:password@localhost:3306/wa_crm"

# External ERP / Website Integration
DESTINATION_ERP_BASE_URL="https://example.com/api"
DESTINATION_ERP_API_KEY="your_api_key_here"

# Meta Lead Ads Integration
META_APP_ID=""
META_APP_SECRET=""
META_ACCESS_TOKEN=""
META_VERIFY_TOKEN=""
META_PAGE_ID=""
META_API_VERSION="v26.0"
# Public origin of the CRM (used to build Meta webhook/OAuth URLs).
PUBLIC_BASE_URL="https://www.wapluscrm.in"
# Optional overrides; defaults are:
#   redirect  => <PUBLIC_BASE_URL>/api/integrations/meta/oauth/callback
#   frontend  => <PUBLIC_BASE_URL>/settings/integrations/meta
#   webhook   => <PUBLIC_BASE_URL>/api/integrations/meta/webhook
META_OAUTH_REDIRECT_URI=""
META_OAUTH_FRONTEND_REDIRECT=""
META_WEBHOOK_URL=""
# Comma-separated OAuth scopes; empty uses the built-in Lead Ads scope set.
META_OAUTH_SCOPES=""

# WhatsApp Business Cloud API
WHATSAPP_API_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_BUSINESS_ACCOUNT_ID=""
WHATSAPP_VERIFY_TOKEN=""
WHATSAPP_API_VERSION="v26.0"

# Meta Click-to-WhatsApp Ad Leads (dedicated signed webhook)
# Callback URL: https://<your-domain>/api/webhook/whatsapp
WHATSAPP_AD_VERIFY_TOKEN=""
WHATSAPP_AD_APP_SECRET=""
WHATSAPP_AD_ACCESS_TOKEN=""
WHATSAPP_AD_BUSINESS_ACCOUNT_ID=""
WHATSAPP_AD_API_VERSION="v26.0"
# Token with ads_read permission used only to resolve campaign/ad names later.
META_MARKETING_ACCESS_TOKEN=""
# Keep two-way chats visible in Communication > WhatsApp (default true).
WHATSAPP_AD_MIRROR_INBOX="true"

# WhatsApp Business App coexistence (Meta Embedded Signup v4/v5)
# Safety gate: onboarding endpoints and the launcher stay locked until true.
WHATSAPP_COEXISTENCE_ENABLED="false"
# Facebook Login for Business configuration ID (WhatsApp Embedded Signup).
WHATSAPP_COEXISTENCE_CONFIG_ID=""
# Optional overrides; fall back to META_APP_ID / META_APP_SECRET.
WHATSAPP_COEXISTENCE_APP_ID=""
WHATSAPP_COEXISTENCE_APP_SECRET=""
WHATSAPP_COEXISTENCE_API_VERSION="v26.0"
# Callback URL defaults to <PUBLIC_BASE_URL>/api/webhook/whatsapp.
WHATSAPP_COEXISTENCE_CALLBACK_URL=""
WHATSAPP_COEXISTENCE_SYNC_DEADLINE_HOURS="24"

# IVR Telephony Integration
IVR_API_KEY=""
IVR_API_SECRET=""
IVR_BASE_URL=""
